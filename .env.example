# Copy this file to .env for local development.
# .env is gitignored — never commit real credentials.
#
# Workflow:
#   Terminal 1: npx ng build --watch   (rebuilds Angular on file changes)
#   Terminal 2: node server.js         (serves the app at http://localhost:4200)
#
# Log in at http://localhost:4200/finance/login with the credentials below.

AUTH_USERNAME=local
AUTH_PASSWORD=local123
AUTH_SESSION_SECRET=local-dev-secret-not-for-production

# JSONBin.io credentials (used in production — see README for setup).
# Leave blank locally to use the sample data below instead.
JSONBIN_API_KEY=
JSONBIN_BIN_ID=

# Sample dashboard data. Used when JSONBIN_API_KEY / JSONBIN_BIN_ID are not set.
# Edit these numbers freely to test different UI states locally.
FINANCE_DASHBOARD_JSON={"title":"Savings Dashboard","updatedAt":"2026-05-06","totalSaved":9800,"averageMonthlyQuota":453,"goals":[{"name":"POM","current":9800,"target":15000,"etaLabel":"Estimated in 11 months"},{"name":"Car Fund","current":0,"target":8000,"etaLabel":"No estimate available"}],"monthlySavings":[{"date":"2025-02-01","amount":380},{"date":"2025-03-01","amount":420},{"date":"2025-04-01","amount":350},{"date":"2025-05-01","amount":450},{"date":"2025-06-01","amount":490},{"date":"2025-07-01","amount":400},{"date":"2025-08-01","amount":520},{"date":"2025-09-01","amount":440},{"date":"2025-10-01","amount":510},{"date":"2025-11-01","amount":480},{"date":"2025-12-01","amount":320},{"date":"2026-01-01","amount":530},{"date":"2026-02-01","amount":470},{"date":"2026-03-01","amount":500},{"date":"2026-04-01","amount":540}],"notes":[]}
